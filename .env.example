# ── Base de datos Neon (PostgreSQL) ───────────────────────────────
# Cópiala desde el dashboard de Neon → Connection string (pooled)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Panel de administración ───────────────────────────────────────
# Contraseña para entrar a /admin
ADMIN_PASSWORD="cambia-esta-clave"
# Cadena aleatoria larga para firmar la cookie de sesión del admin
AUTH_SECRET="genera-una-cadena-aleatoria-larga-aqui"

# ── WhatsApp del negocio (a donde llegan los pedidos) ─────────────
# Formato internacional SIN el signo + y SIN espacios. Bolivia = 591
NEXT_PUBLIC_WHATSAPP="59178064332"
